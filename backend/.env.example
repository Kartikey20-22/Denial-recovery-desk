DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/denial_recovery
SECRET_KEY=replace-with-a-long-random-secret
UPLOAD_DIR=storage/uploads
CORS_ORIGINS=http://localhost:5173

# --- LLM provider (LangChain) ------------------------------------------------
# ollama (default, local, free) | anthropic | groq
LLM_PROVIDER=ollama
LLM_MODEL=llama3.1:8b
LLM_TEMPERATURE=0.1
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b
# Only needed if LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Only needed if LLM_PROVIDER=groq
GROQ_API_KEY=

# --- Embeddings / RAG ---------------------------------------------------------
# local (default, dependency-free, always works offline) | ollama
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=nomic-embed-text
POLICY_DATA_DIR=data/policies
EVIDENCE_DATA_DIR=data/evidence
CHUNK_SIZE=800
CHUNK_OVERLAP=120
RETRIEVAL_TOP_K=4

# --- Workflow / LangGraph -----------------------------------------------------
CONFIDENCE_THRESHOLD=0.90
HIGH_VALUE_THRESHOLD=100000
# true = every appeal pauses for a human click before submission (recommended)
REQUIRE_HUMAN_APPROVAL=true
CHECKPOINT_DB_PATH=storage/checkpoints.sqlite
# RocketRide / hackathon operations
ROCKETRIDE_ENABLED=true
ROCKETRIDE_PIPELINE_NAME=denial-recovery-load-bearing.pipe
ROCKETRIDE_WEBHOOK_KEY=
ESTIMATED_CLOUD_COST_PER_1K_TOKENS_USD=0.001
