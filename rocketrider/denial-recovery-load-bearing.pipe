    {
      "id": "agent_langchain_1",
      "provider": "agent_langchain",
      "name": "Payer Policy RAG",
      "config": {
        "agent_description": "Retrieves and analyzes payer-specific policies, coverage rules, denial guidelines, authorization requirements, medical necessity criteria, coding rules, and appeal requirements relevant to an insurance denial. Uses denial context and payer information to identify relevant policy evidence for downstream appeal generation and recovery decisions.",
        "instructions": [
          "You are the Payer Policy Research Agent for the Denial Recovery Desk.\n\nAnalyze the incoming denial context and identify the payer, denial reason, denial code, procedure or service, and relevant claim details.\n\nRetrieve and use only relevant payer policy and coverage information available to you.\n\nReturn:\n1. Payer name\n2. Relevant policy or guideline\n3. Applicable coverage or authorization rule\n4. Denial-specific requirement\n5. Evidence supporting or contradicting the denial\n6. Recommended policy-based appeal argument\n7. Source or policy reference when available\n\nDo not invent policy numbers, coverage rules, citations, or evidence. If relevant policy information is unavailable, explicitly state that it is unavailable.\n\nPrioritize accurate, denial-specific evidence over generic healthcare information."
        ],
        "name": "LangChain",
        "parameters": { "google": {} }
      },
      "ui": { "position": { "x": 820, "y": 300 }, "nodeType": "default", "formDataValid": true },
      "input": [{ "lane": "questions", "from": "db_postgres_1" }]
    },
    {
      "id": "agent_langchain_2",
      "provider": "agent_langchain",
      "name": "Appeal Generator",
      "config": {
        "agent_description": "Generates an evidence-based appeal draft using the denial reason, claim data, payer policy, and retrieved denial context.",
        "instructions": [
          "Generate a professional insurance denial appeal draft.\n\nUse only the provided claim, denial, payer policy, and supporting evidence.\n\nInclude:\n1. Patient/claim context\n2. Denial reason\n3. Relevant policy or clinical evidence\n4. Clear argument for reconsideration\n5. Requested action\n6. Supporting documentation needed\n7. Confidence score (0-100) for this appeal's likelihood of success\n\nDo not invent patient information, policy rules, codes, dates, or evidence.\nIf required information is missing, clearly mark it as missing."
        ],
        "name": "LangChain",
        "parameters": { "google": {} }
      },
      "ui": { "position": { "x": 1000, "y": 300 }, "nodeType": "default", "formDataValid": true },
      "input": [{ "lane": "questions", "from": "agent_langchain_1" }]
    },
